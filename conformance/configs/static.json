{
  "alias": "localoidc",
  "description": "localoidc - static clients (see conformance/localoidc.toml)",
  "server": {
    "discoveryUrl": "https://localoidc.test/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-client-1",
    "client_secret": "conformance-secret-1"
  },
  "client2": {
    "client_id": "conformance-client-2",
    "client_secret": "conformance-secret-2"
  },
  "client_secret_post": {
    "client_id": "conformance-client-post",
    "client_secret": "conformance-secret-post"
  },
  "browser": [
    {
      "match": "https://localoidc.test/authorize*",
      "tasks": [
        {
          "task": "Sign in",
          "optional": true,
          "match": "https://localoidc.test/authorize*",
          "commands": [
            [
              "wait",
              "xpath",
              "//button[@value='approve']",
              10
            ],
            [
              "click",
              "xpath",
              "//button[@value='approve']"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    },
    {
      "match": "https://localoidc.test/end_session*",
      "tasks": [
        {
          "task": "Verify Complete",
          "match": "*/test/*/post*"
        }
      ]
    }
  ],
  "override": {
